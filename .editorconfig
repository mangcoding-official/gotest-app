root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
# Theme tokens are exposed through these locals by design.
compose_allowed_composition_locals = LocalGotestColors,LocalGotestTypography,LocalGotestShapes,LocalGotestSpacing,LocalGotestSizes

[*.xml]
indent_size = 4
