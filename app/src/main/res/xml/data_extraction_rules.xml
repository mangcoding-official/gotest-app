<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 and higher. The session token is encrypted with a key that never leaves this device, so it is not backed up or moved. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gotest_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gotest_session.xml" />
    </device-transfer>
</data-extraction-rules>
