<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The debug data of Ujian (T-026) fails like a dropped connection while the phone has no network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Debug builds may talk to a local server over http (T-018). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug-only living style guide: adb shell am start -n com.gotest.app/.catalog.DesignSystemCatalogActivity -->
        <activity
            android:name=".catalog.DesignSystemCatalogActivity"
            android:exported="true"
            android:theme="@style/Theme.Gotest" />
    </application>

</manifest>
